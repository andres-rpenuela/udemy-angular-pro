{
  // ========== SERVICIOS ==========
  "Angular Service Test (básico)": {
    "prefix": "ng-service-test",
    "body": [
      "import { TestBed } from '@angular/core/testing';",
      "import { ${1:MyService} } from './${1/(.*)/${1:/downcase}/}.service';",
      "",
      "describe('${1:MyService}', () => {",
      "  let service: ${1:MyService};",
      "",
      "  beforeEach(() => {",
      "    TestBed.configureTestingModule({});",
      "    service = TestBed.inject(${1:MyService});",
      "  });",
      "",
      "  it('debería crearse', () => {",
      "    expect(service).toBeTruthy();",
      "  });",
      "});"
    ],
    "description": "Test básico para un servicio Angular."
  },

  "Angular Service Test con Spy": {
    "prefix": "ng-service-spy-test",
    "body": [
      "import { TestBed } from '@angular/core/testing';",
      "import { ${1:FeatureService} } from './${1/(.*)/${1:/downcase}/}.service';",
      "import { ${2:AuthService} } from './${2/(.*)/${2:/downcase}/}.service';",
      "",
      "describe('${1:FeatureService}', () => {",
      "  let service: ${1:FeatureService};",
      "  let ${2/(.*)/${2:/downcase}/}Spy: jasmine.SpyObj<${2:AuthService}>;",
      "",
      "  beforeEach(() => {",
      "    ${2/(.*)/${2:/downcase}/}Spy = jasmine.createSpyObj('${2:AuthService}', ['isLoggedIn']);",
      "",
      "    TestBed.configureTestingModule({",
      "      providers: [",
      "        ${1:FeatureService},",
      "        { provide: ${2:AuthService}, useValue: ${2/(.*)/${2:/downcase}/}Spy }",
      "      ],",
      "    });",
      "",
      "    service = TestBed.inject(${1:FeatureService});",
      "  });",
      "",
      "  it('retorna true cuando está logueado', () => {",
      "    ${2/(.*)/${2:/downcase}/}Spy.isLoggedIn.and.returnValue(true);",
      "    expect(service.canUseFeature()).toBeTrue();",
      "  });",
      "",
      "  it('retorna false cuando NO está logueado', () => {",
      "    ${2/(.*)/${2:/downcase}/}Spy.isLoggedIn.and.returnValue(false);",
      "    expect(service.canUseFeature()).toBeFalse();",
      "  });",
      "});"
    ],
    "description": "Test de servicio con dependencia mockeada usando jasmine.SpyObj."
  },

  "Angular Service Test con provideHttpClient": {
    "prefix": "ng-service-http-provide-test",
    "body": [
      "import { TestBed } from '@angular/core/testing';",
      "import { ${1:PokemonsService} } from './${1/(.*)/${1:/downcase}/}.service';",
      "import { provideHttpClient } from '@angular/common/http';",
      "import { provideHttpClientTesting } from '@angular/common/http/testing';",
      "import { ${2:SimplePokemon} } from '../interfaces/${2/(.*)/${2:/downcase}/}.interface';",
      "",
      "const expected${2:SimplePokemon}s:${2:SimplePokemon}[] = [",
      "  { id: '1', name: 'Pikachu' },",
      "  { id: '2', name: 'Bulbasaur' }",
      "];",
      "",
      "const mock${2:SimplePokemon}: ${2:SimplePokemon} = {",
      "  id: '1',",
      "  name: 'bulbasaur',",
      "};",
      "",
      "describe('${1:PokemonsService}', () => {",
      "  let service: ${1:PokemonsService};",
      "",
      "  beforeEach(() => {",
      "    TestBed.configureTestingModule({",
      "      providers: [",
      "        provideHttpClient(),",
      "        provideHttpClientTesting(),",
      "      ]",
      "    });",
      "    service = TestBed.inject(${1:PokemonsService});",
      "  });",
      "",
      "  it('debería crearse', () => {",
      "    expect(service).toBeTruthy();",
      "  });",
      "});"
    ],
    "description": "Test de servicio Angular usando provideHttpClient y provideHttpClientTesting."
  },

  "Angular Service Test con HttpClientTestingModule": {
    "prefix": "ng-service-http-test",
    "body": [
      "import { TestBed } from '@angular/core/testing';",
      "import { HttpClientTestingModule, HttpTestingController } from '@angular/common/http/testing';",
      "import { ${1:ApiService} } from './${1/(.*)/${1:/downcase}/}.service';",
      "",
      "describe('${1:ApiService}', () => {",
      "  let service: ${1:ApiService};",
      "  let httpMock: HttpTestingController;",
      "",
      "  beforeEach(() => {",
      "    TestBed.configureTestingModule({",
      "      imports: [HttpClientTestingModule],",
      "      providers: [${1:ApiService}]",
      "    });",
      "    service = TestBed.inject(${1:ApiService});",
      "    httpMock = TestBed.inject(HttpTestingController);",
      "  });",
      "",
      "  afterEach(() => {",
      "    httpMock.verify();",
      "  });",
      "",
      "  it('debe hacer GET y devolver datos', () => {",
      "    const mockData = { id: 1, name: 'Test' };",
      "",
      "    service.${2:getUser}(1).subscribe(data => {",
      "      expect(data).toEqual(mockData);",
      "    });",
      "",
      "    const req = httpMock.expectOne('/api/${2:getUser}/1');",
      "    expect(req.request.method).toBe('GET');",
      "    req.flush(mockData);",
      "  });",
      "});"
    ],
    "description": "Test de servicio Angular con HttpClientTestingModule."
  },

  // ========== COMPONENTES ==========
  "Angular Component Test (básico)": {
    "prefix": "ng-component-test",
    "body": [
      "import { ComponentFixture, TestBed } from '@angular/core/testing';",
      "import { ${1:MyComponent} } from './${1/(.*)/${1:/downcase}/}.component';",
      "",
      "describe('${1:MyComponent}', () => {",
      "  let component: ${1:MyComponent};",
      "  let fixture: ComponentFixture<${1:MyComponent}>;",
      "",
      "  beforeEach(async () => {",
      "    await TestBed.configureTestingModule({",
      "      declarations: [${1:MyComponent}]",
      "    }).compileComponents();",
      "  });",
      "",
      "  beforeEach(() => {",
      "    fixture = TestBed.createComponent(${1:MyComponent});",
      "    component = fixture.componentInstance;",
      "    fixture.detectChanges();",
      "  });",
      "",
      "  it('debería crearse', () => {",
      "    expect(component).toBeTruthy();",
      "  });",
      "});"
    ],
    "description": "Test básico para un componente Angular."
  },

  "Angular Component Test con interacción": {
    "prefix": "ng-component-dom-test",
    "body": [
      "import { ComponentFixture, TestBed } from '@angular/core/testing';",
      "import { By } from '@angular/platform-browser';",
      "import { ${1:MyComponent} } from './${1/(.*)/${1:/downcase}/}.component';",
      "",
      "describe('${1:MyComponent}', () => {",
      "  let component: ${1:MyComponent};",
      "  let fixture: ComponentFixture<${1:MyComponent}>;",
      "",
      "  beforeEach(async () => {",
      "    await TestBed.configureTestingModule({",
      "      declarations: [${1:MyComponent}]",
      "    }).compileComponents();",
      "  });",
      "",
      "  beforeEach(() => {",
      "    fixture = TestBed.createComponent(${1:MyComponent});",
      "    component = fixture.componentInstance;",
      "    fixture.detectChanges();",
      "  });",
      "",
      "  it('debería renderizar el título', () => {",
      "    const element = fixture.debugElement.query(By.css('h1')).nativeElement;",
      "    expect(element.textContent).toContain('Hola');",
      "  });",
      "",
      "  it('debería reaccionar al click en botón', () => {",
      "    spyOn(component, 'onClick');",
      "    const button = fixture.debugElement.query(By.css('button'));",
      "    button.triggerEventHandler('click', null);",
      "    expect(component.onClick).toHaveBeenCalled();",
      "  });",
      "});"
    ],
    "description": "Test de componente Angular con DOM e interacción."
  },

  // ========== ROUTES ==========
  "Angular Routes Test (básico)": {
    "prefix": "ng-routes-test",
    "body": [
      "import { TestBed } from '@angular/core/testing';",
      "import { RouterTestingModule } from '@angular/router/testing';",
      "import { Router } from '@angular/router';",
      "import { Location } from '@angular/common';",
      "import { Component } from '@angular/core';",
      "",
      "@Component({template: '<p>Dummy</p>'})",
      "class DummyComponent {}",
      "",
      "describe('App Routing', () => {",
      "  let router: Router;",
      "  let location: Location;",
      "",
      "  beforeEach(async () => {",
      "    await TestBed.configureTestingModule({",
      "      imports: [",
      "        RouterTestingModule.withRoutes([",
      "          { path: 'dummy', component: DummyComponent }",
      "        ])",
      "      ],",
      "      declarations: [DummyComponent]",
      "    }).compileComponents();",
      "",
      "    router = TestBed.inject(Router);",
      "    location = TestBed.inject(Location);",
      "    router.initialNavigation();",
      "  });",
      "",
      "  it('navega a /dummy', async () => {",
      "    await router.navigate(['/dummy']);",
      "    expect(location.path()).toBe('/dummy');",
      "  });",
      "});"
    ],
    "description": "Test básico para verificar rutas con RouterTestingModule."
  }
}
